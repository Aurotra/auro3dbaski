# Geliştirmede (npm run dev) bu dosyaya gerek yok — Vite proxy'si /api
# isteklerini vite.config.ts'deki backend'e yönlendirir.
#
# Production build'de (npm run build) proxy çalışmaz. Gerçek backend adresini
# buraya yazıp dosyayı ".env.production" olarak kopyalayın (veya CI/CD'de
# ortam değişkeni olarak tanımlayın):
VITE_API_BASE=https://api.example.com
