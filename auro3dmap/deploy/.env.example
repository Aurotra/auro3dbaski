# deploy/.env olarak kopyalayıp doldurun (bu dosya .gitignore'da).
# Backend'e HTTPS ile erişilecek gerçek alt domain — bir DNS A kaydı bu
# VM'in genel IP adresine işaret etmeli (bkz. DEPLOY.md adım 2).
DOMAIN=api.siteniz.com

# Ana sitenizin gerçek domain(ler)i — virgülle ayırın, https:// dahil.
ALLOWED_ORIGINS=https://siteniz.com,https://www.siteniz.com

LOG_LEVEL=INFO
